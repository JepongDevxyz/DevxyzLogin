<?xml version="1.0" encoding="utf-8"?>
<!-- Branded splash (v2.4.0, ANDROID_UI_SPEC_V2.md): WHITE background
     with a centered #00A886 rounded-square tile (~110dp) carrying the
     white logo mark — the layout the real current GoLogin app uses.
     Used as the launch theme's windowBackground so the branded splash
     is up from the first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item
        android:width="110dp"
        android:height="110dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#00A886" />
        </shape>
    </item>
    <item
        android:width="62dp"
        android:height="62dp"
        android:gravity="center"
        android:drawable="@drawable/splash_logo_white" />
</layer-list>
