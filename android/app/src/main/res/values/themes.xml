<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DevxyzLogin" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FFFFFF</item>
    </style>

    <!-- Branded launch theme: green-gradient window background with
         the white logo mark centered — shown from the first frame, no
         white flash. Bar colors match the gradient edge (#009A7D). -->
    <style name="Theme.DevxyzLogin.Splash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">#009A7D</item>
        <item name="android:navigationBarColor">#009A7D</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
